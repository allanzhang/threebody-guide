---
import Base from '../layouts/Base.astro';
import EventBody from '../components/EventBody.astro';
import Linkify from '../components/Linkify.astro';
import {
  sortedEras, eraEvents,
  pageUrl, imageUrl, eventImage, eraHero, sceneForEvent,
} from '../lib/data.mjs';
---
<Base title="时间线 · 三体世界图鉴" description="按纪元年表顺着读完三体三部曲：红岸与危机 → 威慑 → 广播 → 掩体 → 银河与归零。">
  <h1 class="page-title">时间线</h1>
  <p class="page-lead">按纪元年表顺着读：红岸与危机 → 威慑纪元 → 广播纪元 → 掩体纪元 → 银河纪元与归零。每条标注所属书。</p>

  <div class="tl-wrap">
    <aside class="era-nav">
      <p class="era-nav-title">纪元目录</p>
      {sortedEras().map((era) => (
        <a class="era-nav-item" href={`#era-${era.id}`}>
          <span class="era-nav-name">{era.name}</span>
          <span class="era-nav-years">{era.years}</span>
        </a>
      ))}
    </aside>

    <div class="tl-main">
  {sortedEras().map((era) => {
    const list = eraEvents(era.id);
    return (
      <section class="era" id={`era-${era.id}`} style={`--era:${era.color};--era-soft:${era.colorSoft}`}>
        <span class="era-big-year" aria-hidden="true">{era.startYear}</span>
        <div class="era-hero" style={`background-image:url('${imageUrl(eraHero(era))}')`}>
          <div class="era-hero-inner">
            <p class="era-years">{era.years}</p>
            <h2>{era.name}</h2>
            <p class="era-intro"><Linkify text={era.intro} /></p>
          </div>
        </div>
        <div class="timeline">
          {list.map((ev) =>
            ev.isMajorEvent ? (
              (() => {
                const scene = sceneForEvent(ev.id);
                return (
                  <article class="entry major" id={ev.id}>
                    <div class="event-media">
                      <img class="event-img" src={imageUrl(eventImage(ev))} alt={ev.title} loading="lazy" decoding="async" />
                      {scene && (
                        <a class="scene-enter" href={pageUrl(`/scenes/${scene.id}/`)}>
                          <span class="scene-enter-title">{scene.title}</span>
                          <span class="scene-enter-hint">进入沉浸场景 →</span>
                        </a>
                      )}
                    </div>
                    <EventBody ev={ev} />
                  </article>
                );
              })()
            ) : (
              <article class="entry" id={ev.id}>
                <div class="entry-grid-row">
                  <img class="event-img" src={imageUrl(eventImage(ev))} alt={ev.title} loading="lazy" decoding="async" />
                  <EventBody ev={ev} />
                </div>
              </article>
            )
          )}
        </div>
      </section>
    );
  })}
    </div>
  </div>
</Base>
