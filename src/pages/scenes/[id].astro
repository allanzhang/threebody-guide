---
import Base from '../../layouts/Base.astro';
import Linkify from '../../components/Linkify.astro';
import { scenes, sceneById, bookById, eraById, eventById, conceptById, characterById, pageUrl } from '../../lib/data.mjs';

export function getStaticPaths() {
  return scenes.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const s = sceneById.get(id);
const book = s ? bookById.get(s.bookId) : null;
const era = s ? eraById.get(s.eraId) : null;
const title = s ? `${s.title} · 大场面 · 三体世界图鉴` : '未找到';
const desc = s ? `${s.title}｜${s.tagline}。那一幕、为什么震撼、科学底子、伏笔与呼应。` : '三体世界图鉴';
---
<Base title={title} description={desc}>
  {s && (
    <article class="scene-page">
      <section class="scene-stage">
        <canvas id="scene-stars" aria-hidden="true"></canvas>
        <canvas id="scene-fg" aria-hidden="true"></canvas>
        <div class="scene-stage-shade" aria-hidden="true"></div>
        <div class="scene-stage-inner">
          <p class="scene-kicker">{book ? book.title : ''} · {era ? era.name : ''}</p>
          <h1 class="scene-stage-title">{s.title}</h1>
          <p class="scene-stage-tagline">{s.tagline}</p>
        </div>
      </section>

      <div class="scene-body">
        <section class="block moment">
          <h2>那一幕</h2>
          {s.moment.split('\n').map((p) => <p><Linkify text={p} exclude={[s.title]} /></p>)}
        </section>
        <section class="block shock">
          <h2>为什么震撼</h2>
          <p><Linkify text={s.shock} exclude={[s.title]} /></p>
        </section>
        <section class="block science">
          <h2>科学底子</h2>
          <p><Linkify text={s.science} exclude={[s.title]} /></p>
        </section>
        <section class="block echo">
          <h2>伏笔与呼应</h2>
          <p><Linkify text={s.echo} exclude={[s.title]} /></p>
        </section>

        <footer class="detail-links">
          {s.eventIds.length > 0 && (
            <div>
              <h3>相关事件</h3>
              {s.eventIds.map((eid) => {
                const ev = eventById.get(eid);
                return <a class="chip" href={pageUrl(`/timeline/#${eid}`)}>{ev ? ev.title : eid}</a>;
              })}
            </div>
          )}
          {s.conceptIds.length > 0 && (
            <div>
              <h3>相关概念</h3>
              {s.conceptIds.map((cid) => {
                const c = conceptById.get(cid);
                return <a class="chip" href={pageUrl(`/concepts/${cid}/`)}>{c ? c.name : cid}</a>;
              })}
            </div>
          )}
          {s.characterIds.length > 0 && (
            <div>
              <h3>相关人物</h3>
              {s.characterIds.map((cid) => {
                const c = characterById.get(cid);
                return <a class="chip" href={pageUrl(`/characters/${cid}/`)}>{c ? c.name : cid}</a>;
              })}
            </div>
          )}
        </footer>
      </div>
    </article>
  )}
  <script>
    import { createDropletScene } from '../../lib/droplet-scene.js';
    const starsEl = document.getElementById('scene-stars');
    const fgEl = document.getElementById('scene-fg');
    if (starsEl && fgEl) createDropletScene(starsEl, fgEl, {});
  </script>
</Base>
