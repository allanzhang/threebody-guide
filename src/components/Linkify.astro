---
// 正文实体自动内联链接：概念名 / 人物名 / 事件名 → 详情页或时间线锚点（长词优先防部分匹配）
// 优先级：概念/人物 > 事件（同名时链更详细的词条页）
// 被排除的实体保留为 plain：仍占住字符，防止短名钻进被排除的长名里
import { concepts, characters, events, pageUrl } from '../lib/data.mjs';
const { text = '', exclude = [] } = Astro.props;
const EXCLUDE = new Set(exclude);

const rank = (kind) => (kind === 'event' ? 1 : 0);
const ENTITIES = [
  ...concepts.map((c) => ({ name: c.name, url: pageUrl(`/concepts/${c.id}/`), plain: EXCLUDE.has(c.name), kind: 'concept' })),
  ...characters.map((c) => ({ name: c.name, url: pageUrl(`/characters/${c.id}/`), plain: EXCLUDE.has(c.name), kind: 'char' })),
  ...events.map((e) => ({ name: e.title, url: pageUrl(`/timeline/#${e.id}`), plain: EXCLUDE.has(e.title), kind: 'event' })),
].sort((a, b) => b.name.length - a.name.length || rank(a) - rank(b) || a.name.localeCompare(b.name));

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function linkify(t) {
  let out = '';
  let i = 0;
  while (i < t.length) {
    let hit = null;
    for (const e of ENTITIES) {
      if (t.startsWith(e.name, i)) { hit = e; break; }
    }
    if (hit) {
      out += hit.plain ? esc(hit.name) : `<a class="inline-link" href="${hit.url}">${esc(hit.name)}</a>`;
      i += hit.name.length;
      continue;
    }
    out += esc(t[i]);
    i++;
  }
  return out;
}
---
<Fragment set:html={linkify(text)} />
